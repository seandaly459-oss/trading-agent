# Copy this file to .env and fill in your real values.
# Never commit .env — it is listed in .gitignore.

# Alpaca Markets API (paper or live trading)
# Get these from: https://app.alpaca.markets/paper-dashboard -> API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Telegram bot for trade alerts
# 1. Message @BotFather on Telegram to create a bot and get the token
# 2. Message @userinfobot on Telegram to get your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
