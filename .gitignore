# Environment variables — never commit real keys
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache

# Claude Code local settings
.claude/settings.local.json

# launchd plists — contain local machine paths, loaded from install_agents.sh
*.plist

# Runtime state — generated by the agent, contains live order IDs
trading_agent/positions.json
trading_agent/setups.json
trading_agent/intraday_positions.json
trading_agent/intraday_setups.json

# Logs
*.log

# macOS
.DS_Store
Thumbs.db
